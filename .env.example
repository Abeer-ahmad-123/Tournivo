DATABASE_URL=postgres://localhost:55432/tournivo
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Required only for isolated integration tests:
TEST_DATABASE_URL=postgres://localhost:55432/tournivo_test
# Local private evidence storage is development-only. Production requires s3.
EVIDENCE_DRIVER=local
# S3-compatible production storage (bucket MUST be private):
# EVIDENCE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
