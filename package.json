    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
